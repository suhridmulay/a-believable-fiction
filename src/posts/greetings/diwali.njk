<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Diwali! - Firecracker Demo</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow: hidden;
            background: #0a0a1a;
            height: 100vh;
            width: 100vw;
            cursor: crosshair;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        canvas {
            display: block;
        }

        #canvas {
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1;
        }

        #instructions {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: #fff;
            text-align: center;
            pointer-events: none;
            text-shadow: 0 0 10px rgba(255,255,255,0.5);
        }

        #controls {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.85);
            padding: 20px;
            display: flex;
            gap: 25px;
            align-items: center;
            flex-wrap: wrap;
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 100;
        }

        .control-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .control-group label {
            color: #ccc;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .control-group input[type="range"] {
            padding: 8px 12px;
            border: 1px solid #444;
            border-radius: 4px;
            background: #1a1a2a;
            color: #fff;
            font-size: 14px;
            width: 120px;
        }

        .control-group input[type="color"] {
            width: 40px;
            height: 40px;
            padding: 0;
            border: none;
            cursor: pointer;
            border-radius: 4px;
        }

        .control-group input[type="color"]::-webkit-color-swatch-wrapper {
            padding: 0;
        }

        .control-group input[type="color"]::-webkit-color-swatch {
            border: 2px solid #444;
            border-radius: 4px;
        }

        .element-slider {
            width: 150px;
        }

        .element-value {
            color: #aaa;
            font-size: 11px;
            text-align: right;
            min-width: 40px;
        }

        .color-preview {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2px solid #555;
            margin-left: 10px;
        }

        .elements-section {
            display: flex;
            gap: 15px;
            align-items: center;
            padding: 10px 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
        }

        .presets-section {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
            margin-left: 15px;
        }

        .preset-button {
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 4px;
            color: #fff;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.2s ease;
            min-width: 40px;
            text-align: center;
        }

        .preset-button:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .preset-button.active {
            background: #ff6600;
            border-color: #ff8833;
        }

        .save-preset-button {
            padding: 8px 12px;
            background: #ff6600;
            border: none;
            border-radius: 4px;
            color: #fff;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .save-preset-button:hover {
            background: #ff8833;
        }

        .loop-button {
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid #ff6600;
            border-radius: 4px;
            color: #ff6600;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .loop-button:hover {
            background: #ff6600;
            color: #fff;
        }

        .loop-button.active {
            background: #ff6600;
            color: #fff;
            border-color: #ff8833;
        }

        .camera-button {
            padding: 8px 12px;
            background: rgba(0, 150, 255, 0.8);
            border: 1px solid #00aaff;
            border-radius: 4px;
            color: #fff;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .camera-button:hover {
            background: rgba(0, 180, 255, 0.9);
        }

        .camera-button.active {
            background: #00aaff;
            border-color: #00ccff;
        }

        .camera-button.loading {
            background: rgba(0, 150, 255, 0.4);
            cursor: wait;
        }

        #camera-feed {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: calc(100vh - 60px);
            object-fit: cover;
            z-index: 1;
            display: none;
        }

        #segmentation-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: calc(100vh - 60px);
            z-index: 2;
            display: none;
        }

        .preset-color-preview {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.3);
            display: inline-block;
            margin-right: 4px;
        }

        .path-section {
            display: flex;
            gap: 15px;
            align-items: center;
            padding: 10px 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
        }

        .control-group input:focus {
            outline: none;
            border-color: #666;
        }

        #delay-display {
            color: #aaa;
            font-size: 12px;
            min-width: 40px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div id="instructions">Click anywhere to launch a firecracker!</div>
    <video id="camera-feed" autoplay muted playsinline></video>
    <canvas id="segmentation-canvas"></canvas>
    <canvas id="canvas"></canvas>

    <div id="controls">
        <div class="control-group">
            <label for="delay">Delay (seconds)</label>
            <input type="range" id="delay" min="0.1" max="5" step="0.1" value="1" class="element-slider">
            <span id="delay-display" class="element-value">1.0s</span>
        </div>

        <div class="elements-section">
            <div class="control-group">
                <label for="copper">Copper (Green)</label>
                <input type="range" id="copper" min="0" max="100" value="30" class="element-slider">
                <span id="copper-value" class="element-value">30%</span>
            </div>
            <div class="control-group">
                <label for="strontium">Strontium (Red)</label>
                <input type="range" id="strontium" min="0" max="100" value="70" class="element-slider">
                <span id="strontium-value" class="element-value">70%</span>
            </div>
            <div class="control-group">
                <label for="copper-chloride">CuCl₂ (Blue)</label>
                <input type="range" id="copper-chloride" min="0" max="100" value="0" class="element-slider">
                <span id="copper-chloride-value" class="element-value">0%</span>
            </div>
            <div class="color-preview" id="mixed-color-preview"></div>
        </div>

        <div class="path-section">
            <div class="control-group">
                <label for="path-blend">Path Blend</label>
                <input type="range" id="path-blend" min="0" max="100" value="0" class="element-slider">
                <span id="path-blend-value" class="element-value">0%</span>
            </div>
            <div class="control-group">
                <label for="speed">Speed</label>
                <input type="range" id="speed" min="2" max="20" value="8" class="element-slider">
                <span id="speed-value" class="element-value">8</span>
            </div>
            <div class="control-group">
                <label for="angular-velocity">Angular Velocity</label>
                <input type="range" id="angular-velocity" min="0.1" max="5" step="0.1" value="2" class="element-slider">
                <span id="angular-velocity-value" class="element-value">2.0</span>
            </div>
        </div>

        <button class="camera-button" id="toggle-camera">Enable Camera</button>
        <button class="save-preset-button" id="save-preset">Save Preset</button>
        <button class="loop-button" id="loop-presets">Loop Presets</button>
        <div class="presets-section" id="presets-container">
            <!-- Preset buttons will be added here dynamically -->
        </div>
    </div>

    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        const delaySlider = document.getElementById('delay');
        const delayDisplay = document.getElementById('delay-display');

        // Element sliders
        const copperSlider = document.getElementById('copper');
        const strontiumSlider = document.getElementById('strontium');
        const copperChlorideSlider = document.getElementById('copper-chloride');
        const copperValue = document.getElementById('copper-value');
        const strontiumValue = document.getElementById('strontium-value');
        const copperChlorideValue = document.getElementById('copper-chloride-value');
        const mixedColorPreview = document.getElementById('mixed-color-preview');

        // Path controls
        const pathBlendSlider = document.getElementById('path-blend');
        const pathBlendValue = document.getElementById('path-blend-value');
        const speedSlider = document.getElementById('speed');
        const angularVelocitySlider = document.getElementById('angular-velocity');
        const speedValue = document.getElementById('speed-value');
        const angularVelocityValue = document.getElementById('angular-velocity-value');

        // Camera controls
        const cameraButton = document.getElementById('toggle-camera');
        const cameraFeed = document.getElementById('camera-feed');
        const segmentationCanvas = document.getElementById('segmentation-canvas');
        const segmentationCtx = segmentationCanvas.getContext('2d');

        // Preset controls
        const savePresetButton = document.getElementById('save-preset');
        const loopButton = document.getElementById('loop-presets');
        const presetsContainer = document.getElementById('presets-container');

        // Current settings
        let currentDelay = parseFloat(delaySlider.value);
        let currentColor = '#ff6600'; // Default orange
        let currentPathBlend = parseInt(pathBlendSlider.value) / 100; // 0 to 1
        let currentSpeed = parseInt(speedSlider.value);
        let currentAngularVelocity = parseFloat(angularVelocitySlider.value);

        // Element color definitions (real flame colors)
        const elementColors = {
            copper: { r: 0, g: 255, b: 100 },      // Green
            strontium: { r: 255, g: 50, b: 0 },    // Red
            copperChloride: { r: 0, g: 150, b: 255 } // Blue
        };

        // Camera system
        let cameraStream = null;
        let isCameraEnabled = false;
        let bodyPixModel = null;
        let tfLoaded = false;
        let segmentationInterval = null;

        // Preset system
        let presets = [];
        let currentPresetIndex = null;
        let isInterpolating = false;
        let interpolationProgress = 0;
        let interpolationSpeed = 0.02;
        let targetConfig = null;
        let isLooping = false;
        let loopInterval = null;
        let loopDelay = 3000; // 3 seconds between presets

        // Get current config as an object
        function getCurrentConfig() {
            return {
                copper: parseInt(copperSlider.value),
                strontium: parseInt(strontiumSlider.value),
                copperChloride: parseInt(copperChlorideSlider.value),
                pathBlend: parseInt(pathBlendSlider.value),
                speed: parseInt(speedSlider.value),
                angularVelocity: parseFloat(angularVelocitySlider.value),
                color: currentColor
            };
        }

        // Apply config to UI
        function applyConfig(config) {
            copperSlider.value = config.copper;
            strontiumSlider.value = config.strontium;
            copperChlorideSlider.value = config.copperChloride;
            pathBlendSlider.value = config.pathBlend;
            speedSlider.value = config.speed;
            angularVelocitySlider.value = config.angularVelocity;

            // Update display values
            copperValue.textContent = config.copper + '%';
            strontiumValue.textContent = config.strontium + '%';
            copperChlorideValue.textContent = config.copperChloride + '%';
            pathBlendValue.textContent = config.pathBlend + '%';
            speedValue.textContent = config.speed;
            angularVelocityValue.textContent = config.angularVelocity.toFixed(1);

            // Update mixed color
            updateMixedColor();
            mixedColorPreview.style.backgroundColor = config.color;
            currentColor = config.color;

            // Update current settings
            currentPathBlend = config.pathBlend / 100;
            currentSpeed = config.speed;
            currentAngularVelocity = config.angularVelocity;
        }

        // Smoothly interpolate to target config
        function updateInterpolation() {
            if (!isInterpolating || !targetConfig) return;

            interpolationProgress += interpolationSpeed;

            if (interpolationProgress >= 1) {
                interpolationProgress = 1;
                isInterpolating = false;
                applyConfig(targetConfig);
                targetConfig = null;
                return;
            }

            // Interpolate each value
            const startConfig = getCurrentConfig();
            const config = {
                copper: Math.round(startConfig.copper + (targetConfig.copper - startConfig.copper) * interpolationProgress),
                strontium: Math.round(startConfig.strontium + (targetConfig.strontium - startConfig.strontium) * interpolationProgress),
                copperChloride: Math.round(startConfig.copperChloride + (targetConfig.copperChloride - startConfig.copperChloride) * interpolationProgress),
                pathBlend: Math.round(startConfig.pathBlend + (targetConfig.pathBlend - startConfig.pathBlend) * interpolationProgress),
                speed: Math.round(startConfig.speed + (targetConfig.speed - startConfig.speed) * interpolationProgress),
                angularVelocity: startConfig.angularVelocity + (targetConfig.angularVelocity - startConfig.angularVelocity) * interpolationProgress,
                color: blendColors(startConfig.color, targetConfig.color, interpolationProgress)
            };

            applyConfig(config);
        }

        // Blend two hex colors
        function blendColors(color1, color2, ratio) {
            const r1 = parseInt(color1.slice(1, 3), 16);
            const g1 = parseInt(color1.slice(3, 5), 16);
            const b1 = parseInt(color1.slice(5, 7), 16);

            const r2 = parseInt(color2.slice(1, 3), 16);
            const g2 = parseInt(color2.slice(3, 5), 16);
            const b2 = parseInt(color2.slice(5, 7), 16);

            const r = Math.round(r1 + (r2 - r1) * ratio);
            const g = Math.round(g1 + (g2 - g1) * ratio);
            const b = Math.round(b1 + (b2 - b1) * ratio);

            return rgbToHex(r, g, b);
        }

        // Save current preset
        function savePreset() {
            const config = getCurrentConfig();
            presets.push(config);
            renderPresets();
        }

        // Render preset buttons
        function renderPresets() {
            presetsContainer.innerHTML = '';

            presets.forEach((preset, index) => {
                const button = document.createElement('button');
                button.className = 'preset-button';
                if (currentPresetIndex === index) {
                    button.classList.add('active');
                }

                const colorPreview = document.createElement('span');
                colorPreview.className = 'preset-color-preview';
                colorPreview.style.backgroundColor = preset.color;

                button.appendChild(colorPreview);
                button.appendChild(document.createTextNode(`Preset ${index + 1}`));

                button.addEventListener('click', () => {
                    // Start interpolation
                    targetConfig = preset;
                    isInterpolating = true;
                    interpolationProgress = 0;
                    currentPresetIndex = index;

                    // Update active state
                    document.querySelectorAll('.preset-button').forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');
                });

                presetsContainer.appendChild(button);
            });
        }



        // Update element values and mixed color
        function updateMixedColor() {
            const copper = parseInt(copperSlider.value);
            const strontium = parseInt(strontiumSlider.value);
            const copperChloride = parseInt(copperChlorideSlider.value);

            // Update display values
            copperValue.textContent = copper + '%';
            strontiumValue.textContent = strontium + '%';
            copperChlorideValue.textContent = copperChloride + '%';

            // Calculate mixed color based on element ratios
            const total = copper + strontium + copperChloride;
            if (total === 0) {
                // Default to orange if all are zero
                currentColor = '#ff6600';
                mixedColorPreview.style.backgroundColor = currentColor;
                return;
            }

            // Weighted average of RGB values
            const r = Math.round(
                (copper * elementColors.copper.r +
                 strontium * elementColors.strontium.r +
                 copperChloride * elementColors.copperChloride.r) / total
            );
            const g = Math.round(
                (copper * elementColors.copper.g +
                 strontium * elementColors.strontium.g +
                 copperChloride * elementColors.copperChloride.g) / total
            );
            const b = Math.round(
                (copper * elementColors.copper.b +
                 strontium * elementColors.strontium.b +
                 copperChloride * elementColors.copperChloride.b) / total
            );

            // Convert to hex
            currentColor = rgbToHex(r, g, b);
            mixedColorPreview.style.backgroundColor = currentColor;
        }

        // Helper function to convert RGB to hex
        function rgbToHex(r, g, b) {
            return '#' + [r, g, b].map(x => {
                const hex = x.toString(16);
                return hex.length === 1 ? '0' + hex : hex;
            }).join('');
        }

        // Update delay display
        delaySlider.addEventListener('input', () => {
            currentDelay = parseFloat(delaySlider.value);
            delayDisplay.textContent = currentDelay.toFixed(1) + 's';
        });

        // Element slider event listeners
        copperSlider.addEventListener('input', updateMixedColor);
        strontiumSlider.addEventListener('input', updateMixedColor);
        copperChlorideSlider.addEventListener('input', updateMixedColor);

        // Path control event listeners
        pathBlendSlider.addEventListener('input', () => {
            currentPathBlend = parseInt(pathBlendSlider.value) / 100;
            pathBlendValue.textContent = pathBlendSlider.value + '%';
        });

        speedSlider.addEventListener('input', () => {
            currentSpeed = parseInt(speedSlider.value);
            speedValue.textContent = currentSpeed;
        });

        angularVelocitySlider.addEventListener('input', () => {
            currentAngularVelocity = parseFloat(angularVelocitySlider.value);
            angularVelocityValue.textContent = currentAngularVelocity.toFixed(1);
        });

        // Initialize display values
        pathBlendValue.textContent = pathBlendSlider.value + '%';
        speedValue.textContent = currentSpeed;
        angularVelocityValue.textContent = currentAngularVelocity.toFixed(1);

        // Initialize presets with current config as first preset
        presets.push(getCurrentConfig());
        renderPresets();

        // Camera button
        cameraButton.addEventListener('click', toggleCamera);

        // Save preset button
        savePresetButton.addEventListener('click', savePreset);

        // Loop button
        loopButton.addEventListener('click', toggleLoop);

        // Toggle camera on/off
        async function toggleCamera() {
            if (isCameraEnabled) {
                // Disable camera
                stopCamera();
                cameraButton.textContent = 'Enable Camera';
                cameraButton.classList.remove('active');
                isCameraEnabled = false;
            } else {
                // Enable camera
                cameraButton.textContent = 'Loading...';
                cameraButton.classList.add('loading');

                try {
                    // Check WebGL support
                    const canvasTest = document.createElement('canvas');
                    const gl = canvasTest.getContext('webgl') || canvasTest.getContext('experimental-webgl');
                    if (!gl) {
                        console.error('WebGL not supported in this browser');
                        throw new Error('WebGL not supported');
                    }
                    
                    // Request camera access
                    cameraStream = await navigator.mediaDevices.getUserMedia({
                        video: {
                            width: { ideal: 1280 },
                            height: { ideal: 720 },
                            facingMode: 'user'
                        }
                    });

                    cameraFeed.srcObject = cameraStream;

                    // Wait for video to start playing
                    await new Promise((resolve) => {
                        cameraFeed.onloadedmetadata = () => {
                            // Also wait for video to have actual dimensions
                            if (cameraFeed.videoWidth === 0 || cameraFeed.videoHeight === 0) {
                                // Sometimes metadata loads but dimensions are 0, wait a bit more
                                setTimeout(resolve, 500);
                            } else {
                                resolve();
                            }
                        };
                    });

                    // Load TensorFlow.js and BodyPix
                    await loadTfAndBodyPix();
                    
                    // Start segmentation
                    startSegmentation();
                    
                    cameraButton.textContent = 'Disable Camera';
                    cameraButton.classList.remove('loading');
                    cameraButton.classList.add('active');
                    isCameraEnabled = true;

                } catch (error) {
                    cameraButton.textContent = 'Enable Camera';
                    cameraButton.classList.remove('loading');
                    // Fallback to black background (door open for future)
                }
            }
        }

        // Load TensorFlow.js and BodyPix
        async function loadTfAndBodyPix() {
            if (tfLoaded) return;

            // Load TensorFlow.js from CDN - use v2.8.5 for BodyPix compatibility
            await new Promise((resolve, reject) => {
                if (typeof tf !== 'undefined') {
                    resolve();
                    return;
                }
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@2.8.5';
                script.onload = resolve;
                script.onerror = reject;
                document.head.appendChild(script);
            });
            
            // Set TF.js backend to CPU if WebGL fails
            if (typeof tf !== 'undefined') {
                try {
                    await tf.setBackend('webgl');
                } catch (e) {
                    try {
                        await tf.setBackend('cpu');
                    } catch (e2) {
                        throw e2;
                    }
                }
            }
            
            // Load BodyPix from CDN
            await new Promise((resolve, reject) => {
                if (typeof bodyPix !== 'undefined') {
                    resolve();
                    return;
                }
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/@tensorflow-models/body-pix@1.0.0';
                script.onload = resolve;
                script.onerror = reject;
                document.head.appendChild(script);
            });
            
            // Load model - use default configuration
            bodyPixModel = await bodyPix.load();

            tfLoaded = true;
        }

        // Offscreen canvas for BodyPix input
        const offscreenCanvas = document.createElement('canvas');
        const offscreenCtx = offscreenCanvas.getContext('2d');

        // Process segmentation result
        function processSegmentation(segmentation) {
            // Draw segmentation mask to canvas
            const mask = segmentation.data;
            const width = segmentation.width;
            const height = segmentation.height;

            // Set segmentation canvas size to match
            if (segmentationCanvas.width !== width || segmentationCanvas.height !== height) {
                segmentationCanvas.width = width;
                segmentationCanvas.height = height;
            }

            // Clear segmentation canvas
            segmentationCtx.clearRect(0, 0, width, height);

            // Clear segmentation canvas with transparent background
            segmentationCtx.clearRect(0, 0, width, height);
            
            // Clear and draw camera to segmentation canvas
            segmentationCtx.clearRect(0, 0, width, height);
            segmentationCtx.drawImage(cameraFeed, 0, 0, width, height);
            
            // Get camera image data
            const cameraData = segmentationCtx.getImageData(0, 0, width, height);
            
            // Create output with transparency
            // BodyPix returns: 0 = background, 1 = person, 2 = uncertain
            const outputImageData = segmentationCtx.createImageData(width, height);
            
            // Feathering parameters
            const featherRadius = 3; // pixels
            
            for (let i = 0; i < mask.length; i++) {
                const baseIndex = i * 4;
                const x = i % width;
                const y = Math.floor(i / width);
                
                // Copy RGB from camera
                outputImageData.data[baseIndex] = cameraData.data[baseIndex];
                outputImageData.data[baseIndex + 1] = cameraData.data[baseIndex + 1];
                outputImageData.data[baseIndex + 2] = cameraData.data[baseIndex + 2];
                
                // Set alpha with feathering at edges
                // BodyPix: 1 = person, 0 = background
                if (mask[i] === 1) {
                    // Person pixel - check if near background edge
                    let minDist = featherRadius + 1;
                    for (let dy = -featherRadius; dy <= featherRadius; dy++) {
                        for (let dx = -featherRadius; dx <= featherRadius; dx++) {
                            const nx = x + dx;
                            const ny = y + dy;
                            if (nx >= 0 && nx < width && ny >= 0 && ny < height) {
                                const neighborIndex = ny * width + nx;
                                if (mask[neighborIndex] === 0) {
                                    // Found background neighbor - calculate distance
                                    const dist = Math.sqrt(dx * dx + dy * dy);
                                    minDist = Math.min(minDist, dist);
                                }
                            }
                        }
                    }
                    
                    // Set alpha based on distance to edge
                    if (minDist <= featherRadius) {
                        // At edge - feather the alpha
                        const alpha = Math.round(255 * (minDist / featherRadius));
                        outputImageData.data[baseIndex + 3] = alpha;
                    } else {
                        // Inside person - fully opaque
                        outputImageData.data[baseIndex + 3] = 255;
                    }
                } else {
                    // Background pixel
                    outputImageData.data[baseIndex + 3] = 0;
                }
            }
            
            // Put the masked image back to segmentation canvas
            segmentationCtx.clearRect(0, 0, width, height);
            segmentationCtx.putImageData(outputImageData, 0, 0);
            
            segmentationCtx.restore();
        }

        // Start segmentation loop
        function startSegmentation() {
            // Keep both camera feed and segmentation canvas hidden
            // We only need them as sources, not for display
            cameraFeed.style.display = 'none';
            segmentationCanvas.style.display = 'none';

            // Resize to match window
            resizeCanvas();

            // Wait for video to have valid dimensions
            const waitForDimensions = () => {
                if (cameraFeed.videoWidth > 0 && cameraFeed.videoHeight > 0) {
                    // Set segmentation canvas to match video dimensions
                    segmentationCanvas.width = cameraFeed.videoWidth;
                    segmentationCanvas.height = cameraFeed.videoHeight;

                    // Start processing frames
                    processFrame();
                } else {
                    setTimeout(waitForDimensions, 100);
                }
            };
            waitForDimensions();
        }

        // Process each frame
        async function processFrame() {
            if (!isCameraEnabled || !bodyPixModel || cameraFeed.readyState < 3) {
                segmentationInterval = requestAnimationFrame(processFrame);
                return;
            }

            // Check if video has valid dimensions
            if (!cameraFeed.videoWidth || !cameraFeed.videoHeight || cameraFeed.videoWidth === 0 || cameraFeed.videoHeight === 0) {
                segmentationInterval = requestAnimationFrame(processFrame);
                return;
            }

            try {
                // Draw camera to offscreen canvas with fixed dimensions
                const inputWidth = cameraFeed.videoWidth || 640;
                const inputHeight = cameraFeed.videoHeight || 480;

                if (inputWidth === 0 || inputHeight === 0 || isNaN(inputWidth) || isNaN(inputHeight)) {
                    segmentationInterval = requestAnimationFrame(processFrame);
                    return;
                }

                offscreenCanvas.width = inputWidth;
                offscreenCanvas.height = inputHeight;
                offscreenCtx.drawImage(cameraFeed, 0, 0, inputWidth, inputHeight);

                // Get segmentation - BodyPix v1.0.0+ uses estimatePersonSegmentation
                // Use simplest call with no options
                const segmentation = await bodyPixModel.estimatePersonSegmentation(offscreenCanvas);
                processSegmentation(segmentation);

            } catch (error) {
                console.error('Frame processing error:', error);
                // Try CPU backend if WebGL fails
                if (error.message && error.message.includes('shader')) {
                    try {
                        await tf.setBackend('cpu');
                        // Draw to offscreen canvas
                        const inputWidth = cameraFeed.videoWidth || 640;
                        const inputHeight = cameraFeed.videoHeight || 480;
                        offscreenCanvas.width = inputWidth;
                        offscreenCanvas.height = inputHeight;
                        offscreenCtx.drawImage(cameraFeed, 0, 0, inputWidth, inputHeight);

                        // Retry segmentation with CPU backend
                        const segmentation = await bodyPixModel.estimatePersonSegmentation(offscreenCanvas);
                        processSegmentation(segmentation);
                    } catch (e2) {
                        console.error('CPU backend also failed:', e2);
                    }
                    segmentationInterval = requestAnimationFrame(processFrame);
                    return;
                }
                console.error('Segmentation error:', error);
            }

            // Continue loop
            segmentationInterval = requestAnimationFrame(processFrame);
        }

        // Stop camera
        function stopCamera() {
            if (segmentationInterval) {
                cancelAnimationFrame(segmentationInterval);
                segmentationInterval = null;
            }

            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }

            cameraFeed.srcObject = null;
            cameraFeed.style.display = 'none';
            segmentationCanvas.style.display = 'none';

            // Clean up TF.js
            if (tfLoaded && typeof tf !== 'undefined') {
                tf.disposeVariables();
                // Don't set tfLoaded to false - keep model loaded for next use
            }
        }

        // Loop through presets
        function toggleLoop() {
            isLooping = !isLooping;
            loopButton.classList.toggle('active', isLooping);

            if (isLooping) {
                startLoop();
            } else {
                stopLoop();
            }
        }

        function startLoop() {
            if (presets.length === 0) return;

            // Start from current preset or first one
            if (currentPresetIndex === null) {
                currentPresetIndex = 0;
            }

            // Highlight current preset
            document.querySelectorAll('.preset-button').forEach(btn => btn.classList.remove('active'));
            if (document.querySelectorAll('.preset-button')[currentPresetIndex]) {
                document.querySelectorAll('.preset-button')[currentPresetIndex].classList.add('active');
            }

            // Apply current preset immediately
            targetConfig = presets[currentPresetIndex];
            isInterpolating = true;
            interpolationProgress = 0;

            // Set up interval for next preset
            loopInterval = setInterval(() => {
                currentPresetIndex = (currentPresetIndex + 1) % presets.length;

                // Update active state
                document.querySelectorAll('.preset-button').forEach(btn => btn.classList.remove('active'));
                if (document.querySelectorAll('.preset-button')[currentPresetIndex]) {
                    document.querySelectorAll('.preset-button')[currentPresetIndex].classList.add('active');
                }

                // Start interpolation to next preset
                targetConfig = presets[currentPresetIndex];
                isInterpolating = true;
                interpolationProgress = 0;
            }, loopDelay);
        }

        function stopLoop() {
            if (loopInterval) {
                clearInterval(loopInterval);
                loopInterval = null;
            }
        }

        // Set canvas to full window size
        function resizeCanvas() {
            const controlsHeight = 60;
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight - controlsHeight;

            // Update camera feed size
            cameraFeed.style.width = `${window.innerWidth}px`;
            cameraFeed.style.height = `${window.innerHeight - controlsHeight}px`;

            // If camera is enabled, update segmentation canvas
            if (isCameraEnabled && cameraFeed.videoWidth > 0) {
                segmentationCanvas.width = cameraFeed.videoWidth;
                segmentationCanvas.height = cameraFeed.videoHeight;
            }
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        // Firecracker class
        class Firecracker {
            constructor(targetX, targetY) {
                this.startX = Math.random() * canvas.width;
                this.startY = canvas.height + 20;
                this.x = this.startX;
                this.y = this.startY;
                this.targetX = targetX;
                this.targetY = targetY;
                this.speed = currentSpeed;
                this.angularVelocity = currentAngularVelocity;
                this.color = currentColor;
                this.pathBlend = currentPathBlend;
                this.trail = [];
                this.maxTrailLength = 30;
                this.exploded = false;
                this.particles = [];
                this.explosionRadius = 0;
                this.maxExplosionRadius = 30;
                this.explosionSpeed = 6;
                this.launchTime = Date.now();
                this.progress = 0;
                this.totalDistance = Math.sqrt(
                    Math.pow(targetX - this.startX, 2) +
                    Math.pow(targetY - this.startY, 2)
                );

                // For cycloid: track the angle for the circular motion
                this.cycloidAngle = 0;
                this.cycloidRadius = 40;
            }

            update() {
                if (this.exploded) {
                    this.explosionRadius += this.explosionSpeed;

                    // Update particles
                    for (let i = this.particles.length - 1; i >= 0; i--) {
                        const p = this.particles[i];
                        p.x += p.vx;
                        p.y += p.vy;
                        p.vy += 0.05; // reduced gravity
                        p.life--;

                        if (p.life <= 0) {
                            this.particles.splice(i, 1);
                        }
                    }

                    return this.explosionRadius >= this.maxExplosionRadius && this.particles.length === 0;
                }

                this.progress += this.speed / this.totalDistance;

                if (this.progress >= 1) {
                    this.x = this.targetX;
                    this.y = this.targetY;
                    this.explode();
                    return false;
                }

                // Calculate position based on path blend (0 = straight, 1 = parabola)
                // Straight line
                const straightX = this.startX + (this.targetX - this.startX) * this.progress;
                const straightY = this.startY + (this.targetY - this.startY) * this.progress;

                // Parabola: peaks at target, starts from bottom
                const parabolaHeight = 150;
                const parabolaX = this.startX + (this.targetX - this.startX) * this.progress;
                const parabolaY = this.startY + (this.targetY - this.startY) * this.progress -
                                 parabolaHeight * Math.sin(this.progress * Math.PI);

                // Blend between straight and parabola
                this.x = straightX + (parabolaX - straightX) * this.pathBlend;
                this.y = straightY + (parabolaY - straightY) * this.pathBlend;

                // Update cycloid angle - use a fixed increment based on angular velocity
                // The angle should progress independently of distance to create visible cycloids
                const angleIncrement = this.angularVelocity * 0.1;
                this.cycloidAngle += angleIncrement;

                // Add to trail with cycloid offset
                const cycloidX = this.x + Math.cos(this.cycloidAngle) * this.cycloidRadius;
                const cycloidY = this.y + Math.sin(this.cycloidAngle) * this.cycloidRadius;

                this.trail.push({
                    x: cycloidX,
                    y: cycloidY,
                    size: this.size,
                    angle: this.cycloidAngle
                });
                if (this.trail.length > this.maxTrailLength) {
                    this.trail.shift();
                }

                return false;
            }

            explode() {
                this.exploded = true;

                // Create explosion particles
                const particleCount = 80;
                for (let i = 0; i < particleCount; i++) {
                    // Bias angles to spread more evenly in all directions
                    const angle = Math.random() * Math.PI * 2;
                    const velocity = Math.random() * 3 + 1.5;
                    const vx = Math.cos(angle) * velocity;
                    const vy = Math.sin(angle) * velocity;
                    const size = Math.random() * 0.5 + 0.25;
                    const life = Math.random() * 60 + 30;

                    // Use the firecracker color with some variation
                    const hue = this.hexToHsl(this.color).h;
                    const saturation = this.hexToHsl(this.color).s;
                    const particleHue = (hue + Math.random() * 30 - 15) % 360;
                    const particleColor = `hsl(${particleHue}, ${saturation}%, ${Math.random() * 40 + 60}%)`;

                    this.particles.push({
                        x: this.x,
                        y: this.y,
                        vx: vx,
                        vy: vy,
                        size: size,
                        color: particleColor,
                        life: life
                    });
                }
            }

            hexToHsl(hex) {
                // Convert hex to RGB first
                let r = 0, g = 0, b = 0;
                if (hex.length == 4) {
                    r = parseInt(hex[1] + hex[1], 16);
                    g = parseInt(hex[2] + hex[2], 16);
                    b = parseInt(hex[3] + hex[3], 16);
                } else if (hex.length == 7) {
                    r = parseInt(hex[1] + hex[2], 16);
                    g = parseInt(hex[3] + hex[4], 16);
                    b = parseInt(hex[5] + hex[6], 16);
                }

                // Then to HSL
                r /= 255;
                g /= 255;
                b /= 255;
                const max = Math.max(r, g, b);
                const min = Math.min(r, g, b);
                let h = 0, s, l = (max + min) / 2;

                if (max == min) {
                    h = s = 0; // achromatic
                } else {
                    const d = max - min;
                    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
                    switch (max) {
                        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
                        case g: h = (b - r) / d + 2; break;
                        case b: h = (r - g) / d + 4; break;
                    }
                    h /= 6;
                }

                return {
                    h: Math.round(h * 360),
                    s: Math.round(s * 100),
                    l: Math.round(l * 100)
                };
            }

            draw() {
                if (this.exploded) {
                    // Draw explosion particles
                    for (const p of this.particles) {
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                        ctx.fillStyle = p.color;
                        ctx.fill();
                    }

                    // Draw explosion glow using the firecracker color
                    const rgb = this.hexToRgb(this.color);
                    const gradient = ctx.createRadialGradient(
                        this.x, this.y, 0,
                        this.x, this.y, this.explosionRadius
                    );
                    gradient.addColorStop(0, `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.3)`);
                    gradient.addColorStop(0.7, `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.05)`);
                    gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.explosionRadius, 0, Math.PI * 2);
                    ctx.fillStyle = gradient;
                    ctx.fill();

                    return;
                }

                // Draw cycloid trail
                if (this.trail.length > 1) {
                    ctx.beginPath();
                    ctx.moveTo(this.trail[0].x, this.trail[0].y);

                    for (let i = 1; i < this.trail.length; i++) {
                        const point = this.trail[i];
                        ctx.lineTo(point.x, point.y);
                    }

                    const rgb = this.hexToRgb(this.color);
                    ctx.strokeStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.6)`;
                    ctx.lineWidth = 2;
                    ctx.lineCap = 'round';
                    ctx.lineJoin = 'round';
                    ctx.stroke();

                    // Draw fading trail points
                    for (let i = 0; i < this.trail.length; i++) {
                        const point = this.trail[i];
                        const alpha = i / this.trail.length;
                        ctx.beginPath();
                        ctx.arc(point.x, point.y, 2 * (0.5 + alpha * 0.5), 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha * 0.5})`;
                        ctx.fill();
                    }
                }

                // Draw firecracker at actual position (not cycloid offset)
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.fill();

                // Draw fuse glow
                const rgb = this.hexToRgb(this.color);
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size * 2, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.3)`;
                ctx.fill();
            }

            hexToRgb(hex) {
                let r = 0, g = 0, b = 0;
                if (hex.length == 4) {
                    r = parseInt(hex[1] + hex[1], 16);
                    g = parseInt(hex[2] + hex[2], 16);
                    b = parseInt(hex[3] + hex[3], 16);
                } else if (hex.length == 7) {
                    r = parseInt(hex[1] + hex[2], 16);
                    g = parseInt(hex[3] + hex[4], 16);
                    b = parseInt(hex[5] + hex[6], 16);
                }
                return { r, g, b };
            }
        }

        const firecrackers = [];
        let lastFirecrackerTime = 0;

        function animate() {
            // Update preset interpolation
            updateInterpolation();

            // Clear canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (isCameraEnabled && cameraFeed.readyState >= 3) {
                // Camera is active - composite fireworks behind user

                // Get display dimensions
                const displayWidth = canvas.width;
                const displayHeight = canvas.height;

                // Draw firecrackers first (they go in the background)
                for (let i = firecrackers.length - 1; i >= 0; i--) {
                    const firecracker = firecrackers[i];
                    const done = firecracker.update();
                    firecracker.draw();

                    if (done) {
                        firecrackers.splice(i, 1);
                    }
                }

                // Draw the segmented camera feed (person only) on top
                // This will show the person with transparent background over the firecrackers
                ctx.save();
                ctx.globalCompositeOperation = 'source-over';
                ctx.drawImage(segmentationCanvas,
                    0, 0, segmentationCanvas.width, segmentationCanvas.height,
                    0, 0, displayWidth, displayHeight);
                ctx.restore();

            } else {
                // No camera - use original behavior with black background
                ctx.fillStyle = 'rgba(10, 10, 26, 0.1)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // Update and draw firecrackers
                for (let i = firecrackers.length - 1; i >= 0; i--) {
                    const firecracker = firecrackers[i];
                    const done = firecracker.update();
                    firecracker.draw();

                    if (done) {
                        firecrackers.splice(i, 1);
                    }
                }
            }

            requestAnimationFrame(animate);
        }

        // Handle clicks
        canvas.addEventListener('click', (e) => {
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            firecrackers.push(new Firecracker(x, y));
        });

        // Allow touch events for mobile
        canvas.addEventListener('touchend', (e) => {
            e.preventDefault();
            const rect = canvas.getBoundingClientRect();
            const touch = e.changedTouches[0];
            const x = touch.clientX - rect.left;
            const y = touch.clientY - rect.top;

            firecrackers.push(new Firecracker(x, y));
        });

        // Clean up on page unload
        window.addEventListener('beforeunload', () => {
            stopCamera();
        });

        // Auto-launch firecrackers with delay
        function launchRandomFirecracker() {
            const now = Date.now();
            if (now - lastFirecrackerTime > currentDelay * 1000) {
                const x = Math.random() * canvas.width;
                const y = Math.random() * canvas.height * 0.5 + canvas.height * 0.25;
                firecrackers.push(new Firecracker(x, y));
                lastFirecrackerTime = now;
            }
            requestAnimationFrame(launchRandomFirecracker);
        }

        // Start animations
        animate();
        launchRandomFirecracker();

        // Initialize delay display
        delayDisplay.textContent = currentDelay.toFixed(1) + 's';
    </script>
</body>
</html>
